            <!--  CONSENT INIT  -->
<script>
    (function () {

        function getCookie(name) {
            const match = document.cookie.match(
                new RegExp('(?:^|; )' + name.replace(/([.$?|{}()[\]\\/+^])/g, '\\$1') + '=([^;]*)')
            );
            return match ? match[1] : null;
        }

        function parseConsentCookie(rawValue) {
            if (!rawValue) return null;

            try {
                const decoded = decodeURIComponent(rawValue);
                return JSON.parse(decoded);
            } catch (e) {
                console.warn('Failed to parse consent cookie:', e);
                return null;
            }
        }

        const rawCookieConsent = getCookie('cookieConsent');
        const consent = parseConsentCookie(rawCookieConsent);

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { dataLayer.push(arguments); };

        function map(val) {
            return val === true ? 'granted' : 'denied';
        }

        const consentMode = {
            analytics_storage: map(consent?.analytics_storage),
            ad_storage: map(consent?.ad_storage),
            ad_user_data: map(consent?.ad_user_data),
            ad_personalization: map(consent?.ad_personalization),
            functionality_storage: map(consent?.functionality_storage),
            personalization_storage: map(consent?.personalization_storage),
            security_storage: 'granted'
        };

        if (consent) {
            gtag('consent', 'update', consentMode);
        } else {
            gtag('consent', 'default', consentMode);
        }

        dataLayer.push({
            event: 'consent_update',
            cookieConsentRaw: rawCookieConsent,
            ...consentMode
        });

    })();
</script>

