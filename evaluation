        // execCommand('copy') is deprecated but it is the only path that works
        // without a secure context, and it needs a real selection to act on.
        function legacyWrite(text) {
          return new Promise(function (resolve, reject) {
            var field = document.createElement('textarea');
            field.value = text;
            field.setAttribute('readonly', '');
            field.style.cssText = 'position:fixed;top:-1000px;left:-1000px;opacity:0';

            document.body.appendChild(field);
            field.select();
