      window.gaReady = true;

      window.gaEvent = function (name, params = {}) {
        params.transport_type = 'beacon';

        if (window.gaReady && typeof window.gtag === 'function') {
          gtag('event', name, params);
        } else {
          window._gaQueue = window._gaQueue || [];
          window._gaQueue.push([name, params]);
        }
      };

      window.addEventListener('load', function () {
        if (Array.isArray(window._gaQueue) && typeof gtag === 'function') {
          for (const [n, p] of window._gaQueue) gtag('event', n, p);
          window._gaQueue.length = 0;
        }
      });

      $(document).on('click', 'a.ga-track', function () {
        const $link = $(this);
        const href = $link.attr('href') || '';
        if (!href) return;

        const isOutbound = (new URL(href, window.location.href)).host !== window.location.host;

        window.gaEvent($link.data('ga-event'), {
          link_url: href,
          link_text: $link.data('ga-label') || $.trim($link.text()).slice(0, 100),
          outbound: isOutbound ? '1' : '0',
        });
      });

